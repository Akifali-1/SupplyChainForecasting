aws_region        = "us-east-1"
app_name          = "supplygraph"
github_org        = "YOUR_GITHUB_USERNAME"
github_repo       = "SupplyChainForecasting"
ec2_key_pair_name = "supplygraph-key" # Name of your AWS Key Pair
your_ip_cidr      = "0.0.0.0/0"        # Replace with your public IP CIDR (e.g. 203.0.113.50/32) for secure SSH access
